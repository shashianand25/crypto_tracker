# Copy to .env to override. Every line is optional; the values shown are the defaults.
PORT=3000
CORS_ORIGIN=http://localhost:5173
CASSANDRA_HOST=127.0.0.1:9042
CASSANDRA_DC=datacenter1
CASSANDRA_KEYSPACE=crypto

# Anomaly detection (lower these in .env for a live demo, then restore them)
ANOMALY_Z_THRESHOLD=4
ANOMALY_WARMUP_SECONDS=300
ANOMALY_COOLDOWN_SECONDS=60
# smallest 1-second price move (in percent) that can count as a price anomaly
ANOMALY_MIN_MOVE_PCT=0.03
